{
  "description": "Reflector: routes implemented hook events to the decision-model judge for write scorecards and Stop gate review",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-reflector.py\"",
            "timeout": 360
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-reflector.py\"",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
